# Ponder's own database (Neon Postgres). Include ?sslmode=require.
DATABASE_URL=postgresql://USER:PASS@HOST/db?sslmode=require
# Ponder schema — REQUIRED by `ponder start` in production (no default).
DATABASE_SCHEMA=indexer_v1

# Server-side RPC per chain (Infura/Alchemy/etc. — must support eth_getLogs).
PONDER_BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_KEY
PONDER_ETH_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# PONDER_ARB_SEPOLIA_RPC_URL=   # set only once Arbitrum Sepolia contracts are deployed
# PONDER_ANVIL_RPC_URL=http://127.0.0.1:8545

# Supabase (service role bypasses RLS — server-side only, never EXPO_PUBLIC).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Contract addresses + factory deploy blocks are baked into src/addresses.ts as
# defaults (portable across chains); override here only if redeployed:
# BASE_SEPOLIA_ACCOUNT_FACTORY=
# BASE_SEPOLIA_START_BLOCK=41380204
# ETH_SEPOLIA_START_BLOCK=10945815
