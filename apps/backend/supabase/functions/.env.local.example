# Local Edge Function custom secrets for recovery development.
# Copy to: apps/backend/supabase/functions/.env.local
#
# scripts/infra-up.sh will inject the local SUPABASE_URL,
# SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY automatically into a
# generated runtime env file before serving edge functions.
#
# Required for submit-recovery-operation:
# Use a funded local Anvil key. Do not commit real private keys.
RECOVERY_RELAYER_PRIVATE_KEY=<INSERT_FUNDED_TESTNET_PRIVATE_KEY_HERE>

# Optional but recommended override for local chain 31337.
# Since edge runtime is in Docker, host.docker.internal is safer than localhost.
RECOVERY_RPC_URL_31337=http://host.docker.internal:8545

# Optional host alias for localhost-like RPC URLs.
RECOVERY_LOCALHOST_ALIAS=host.docker.internal

# ─── Transak on-ramp (see docs/decisions/0012 + docs/transak-onramp-demo.md) ───
# Provider selection for the onramp-session / onramp-webhook functions.
RAMP_PROVIDER=transak
# STAGING (testnet) or PRODUCTION. Treasury fulfillment is hard-disabled in PRODUCTION.
TRANSAK_ENV=STAGING
# Partner credentials from dashboard.transak.com → Developers.
# The SECRET must never be exposed client-side or committed.
TRANSAK_STAGING_API_KEY=<INSERT_TRANSAK_API_KEY_HERE>
TRANSAK_API_SECRET=<INSERT_TRANSAK_API_SECRET_HERE>
# REQUIRED by the Create Widget URL API. Staging accepts any value; for PRODUCTION
# it must be a domain whitelisted in the Transak dashboard.
TRANSAK_REFERRER_DOMAIN=trezo.app
# (production keys, when/if you ever flip TRANSAK_ENV=PRODUCTION)
# TRANSAK_API_KEY=<INSERT_PRODUCTION_API_KEY_HERE>

# ─── Testnet demo fund delivery ────────────────────────────────────────────────
# Transak STAGING never delivers the real asset to the wallet, so a Trezo treasury
# EOA grants real testnet ETH on a *verified* completion. Testnet-demo only.
TESTNET_DEMO_FULFILLMENT=true
# Funded treasury EOA private key (Base Sepolia faucet ETH). Do NOT commit a real key.
TREASURY_PRIVATE_KEY=<INSERT_TREASURY_PRIVATE_KEY_HERE>
# Per-order ETH cap so a verified order can never drain the treasury.
TESTNET_DEMO_MAX_ETH=0.01
# Optional RPC overrides (defaults: Base Sepolia https://sepolia.base.org).
# BASE_SEPOLIA_RPC_URL=
# SEPOLIA_RPC_URL=
# ARB_SEPOLIA_RPC_URL=

# ─── Push Notifications ────────────────────────────────────────────────────────
# Required for send-push-notification to bypass Expo rate limits
EXPO_ACCESS_TOKEN=<INSERT_EXPO_ACCESS_TOKEN_HERE>
