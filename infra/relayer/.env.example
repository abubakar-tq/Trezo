# ─────────────────────────────────────────────────────────────────────────────
# Trezo Across testnet relayer — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to `.env` and fill in real values before running `make relayer-up`.
# NEVER commit `.env` (it's in this directory's .gitignore).

# ── Relayer wallet ───────────────────────────────────────────────────────────
# Throwaway testnet wallet. NEVER reuse the trezo-testnet-deployer keystore key.
# Fund this address with testnet WETH + USDC on each of the 3 testnets — the
# relayer fronts capital from this wallet and earns it back on every fill.
RELAYER_PRIVATE_KEY=0x__throwaway_testnet_key__

# ── Per-chain RPC URLs ───────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Optional: monitoring ──────────────────────────────────────────────────────
# RELAYER_DISCORD_WEBHOOK=
# RELAYER_LOG_LEVEL=info
